# Safe reference template — copy to .env.local for machine-specific overrides.
# .env.local is gitignored and must NEVER be committed.

# Site Stage: TEST (RecipeBinderDB_Test) | LIVE (RecipeBinderDB)
VITE_SITE_STAGE=TEST

# Optional Firebase Web App Config (enables cross-device Auth & Cloud Firestore sync).
# Firebase web config values are client app identifiers protected by firestore.rules,
# NOT private admin credentials. Leave blank to run 100% offline.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Optional custom CORS/recipe fetch proxy URL (only needed when hosting statically,
# such as GitHub Pages, if you want a custom Cloudflare Worker instead of public CORS fallback).
# VITE_RECIPE_PROXY_URL=

# Optional local Ollama server URL for the Vite dev/preview proxy (/api/ai/ollama/*).
# Defaults to http://127.0.0.1:11434 when Ollama is running on the same PC.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
